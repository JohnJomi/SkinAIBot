{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnalyzeResponse",
  "type": "object",
  "properties": {
    "analysis_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "processing"]
    },
    "model_version": {
      "type": "string"
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": ["label", "confidence"]
      }
    },
    "confidence_status": {
      "type": "string",
      "enum": ["high", "moderate", "low"]
    },
    "explanation": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "disclaimer": {
      "type": "string"
    }
  },
  "required": ["analysis_id", "status", "predictions"]
}
