{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatRequest",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Identifier for the conversation session"
    },
    "message": {
      "type": "string"
    },
    "analysis_id": {
      "type": ["string", "null"],
      "description": "Optional context regarding a previous analysis"
    }
  },
  "required": ["session_id", "message"]
}
