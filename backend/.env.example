DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/skinaibot
AI_SERVICE_URL=http://localhost:8001

# Required. Generate a unique secret per environment, e.g. `openssl rand -hex 32`.
# Must be at least 32 characters. Never commit a real secret.
JWT_SECRET_KEY=<replace-me-with-openssl-rand-hex-32>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

UPLOAD_DIR=uploads

