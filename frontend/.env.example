# Frontend environment. Copy to frontend/.env.local — no secrets belong here:
# every VITE_* value is compiled into the browser bundle.

# Application backend (FastAPI). Default matches the existing lib/api.ts fallback.
VITE_API_BASE_URL=http://localhost:8000

# Absolute URL template for an uploaded image, used as `image_url` on
# POST /api/v1/analyze. Leave UNSET until the backend exposes a route that serves
# or signs uploads — the Upload screen then shows an explicit configuration
# notice instead of failing an analysis. `{id}` and `{filename}` are substituted.
# VITE_UPLOAD_URL_TEMPLATE=http://localhost:8000/static/uploads/{id}

# Demo mode: render fixture data from src/lib/mockData.ts, no backend needed.
# Use for design review only.
VITE_USE_MOCK_DATA=false
