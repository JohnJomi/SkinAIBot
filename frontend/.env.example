# Frontend environment. Copy to frontend/.env.local — no secrets belong here:
# every VITE_* value is compiled into the browser bundle.

# Application backend (FastAPI). Default matches the existing lib/api.ts fallback.
VITE_API_BASE_URL=http://localhost:8000

# OPTIONAL. Overrides only the server-side URL the AI service fetches
# (analysis_image_url); it does not affect the browser's display_image_url.
# Not needed for normal use: the backend serves uploads itself and returns both
# URLs. Set it only when stored images are served from elsewhere (CDN, object
# store), and give a value reachable from the SERVER, not just a browser.
# `{id}` is the upload row id and `{filename}` the original filename - neither
# matches the backend's own route, which is keyed on the stored filename.
# VITE_UPLOAD_URL_TEMPLATE=https://cdn.example.com/uploads/{id}

# Demo mode: render fixture data from src/lib/mockData.ts, no backend needed.
# Use for design review only.
VITE_USE_MOCK_DATA=false
